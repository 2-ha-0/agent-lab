{
  "name": "agent-lab",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-lab/api --filter @agent-lab/web dev",
    "dev:api": "pnpm --filter @agent-lab/api start:dev",
    "dev:web": "pnpm --filter @agent-lab/web dev",
    "build": "pnpm --filter @agent-lab/api build && pnpm --filter @agent-lab/web build",
    "build:api": "pnpm --filter @agent-lab/api build",
    "build:web": "pnpm --filter @agent-lab/web build",
    "lint": "pnpm --filter @agent-lab/api lint && pnpm --filter @agent-lab/web lint",
    "test": "pnpm --filter @agent-lab/api test",
    "prisma:seed": "pnpm --filter @agent-lab/api prisma:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.6",
    "langchain": "^1.5.5",
    "zod": "^4.4.3"
  }
}
